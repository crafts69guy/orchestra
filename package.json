{
  "name": "@crafts69guy/orchestra",
  "version": "0.8.1",
  "type": "module",
  "description": "Cross-harness (Claude Code + Codex) orchestration workflow plugin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crafts69guy/orchestra.git"
  },
  "homepage": "https://github.com/crafts69guy/orchestra",
  "keywords": [
    "claude-code",
    "codex",
    "orchestration",
    "subagents",
    "worktrees",
    "cli"
  ],
  "bin": {
    "orch": "bin/orch"
  },
  "files": [
    "bin",
    "scripts",
    "hooks",
    "rules",
    "agents",
    "skills",
    "codex",
    ".claude-plugin",
    ".codex-plugin",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.8"
  },
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-lines=98 --test-coverage-branches=98 --test-coverage-functions=98 --test-coverage-exclude='test/**'",
    "lint": "biome check . && markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "fmt": "biome format --write .",
    "gen:codex": "node scripts/gen-codex-agents.mjs",
    "check": "npm run lint && npm run gen:codex -- --check && npm test",
    "validate": "claude plugin validate .",
    "eval": "sh evals/_support/run.sh",
    "eval:bench": "sh evals/_support/bench.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "markdownlint-cli2": "0.23.3"
  }
}
